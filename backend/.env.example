# Копировать в .env и заполнить
APP_NAME="Monitoring System"
APP_VERSION="1.0.0"
DEBUG=true

# SQLite для разработки. Для продакшена PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/monitoring
DATABASE_URL=sqlite:///./monitoring.db

API_PREFIX=/api

AGENT_TOKEN_HEADER=X-Agent-Token
SECRET_KEY=change-this-in-production

HISTORY_RETENTION_DAYS=90

# --- Алерты ---
# Сколько проверок подряд НЕ "up" нужно для алерта
ALERT_CONSECUTIVE_FAILURES=2
# Период проверки (сек) фоновым детектором
ALERT_CHECK_INTERVAL_SECONDS=30

# --- Уведомления ---
# none | telegram | discord | slack
NOTIFICATION_CHANNEL=none
# Для telegram: токен бота и chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для discord/slack: URL webhook
WEBHOOK_URL=

