# Конфигурация агента мониторинга.
# Скопируйте этот файл в config.yaml и отредактируйте под свою сеть.

# --- Бэкенд (сервер) ---
backend:
  url: "http://192.168.1.100"   # базовый адрес FastAPI-сервера (порт 80)
  token: "change-me-shared-secret"    # значение заголовка X-Agent-Token
  timeout: 10                          # таймаут HTTP-запросов к бэкенду, сек
  retry_attempts: 3                    # кол-во попыток отправить heartbeat
  retry_delay: 5                        # задержка между попытками, сек
  buffer_max: 500                       # макс. отложенных сообщений при недоступном бэкенде

# --- Периодичность ---
check_interval: 30                      # проверять сервисы каждые N секунд

# --- Инвентаризация хоста ---
# Клиент сам собирает данные локально и отправляет только метаданные.
# Для Windows используются certificate_roots и windows_services.
# Для Linux можно использовать certificate_roots (пути к PEM-файлам/каталогам)
# и, при необходимости, расширить inventory.py под свои нужды.
inventory:
  enabled: true
  host_id: "office-pc-01"
  # Укажите один или несколько каталогов; подпапки сканируются автоматически.
  # Windows:
  certificate_roots:
    - "C:\\Certificates"
  windows_services:
    - "Spooler"
    - "W32Time"
  # Linux (пример):
  # certificate_roots:
  #   - "/etc/ssl/certs"
  #   - "/usr/local/share/ca-certificates"
discovery:
  enabled: true
  port: 19443
  # Клиент слушает TCP-порт только для подписанного запроса обнаружения.

# --- Таймауты проверок ---
check_timeout: 5                         # таймаут tcp/http/icmp проверок, сек

# --- Логирование ---
logging:
  level: "INFO"                          # DEBUG | INFO | WARNING | ERROR
  file: "agent.log"                      # путь к файлу лога; пусто/"console" -> stdout
  max_mb: 10                             # авто-обрезка: лог сменяется новым при достижении размера (МБ)

# --- Список проверяемых сервисов ---
# type: tcp | http | https | icmp | disk | cpu | memory | network | windows_service
# Поле name уникально идентифицирует сервис на сервере (агент сам создаст его в БД,
# если оно отсутствует).
services:
  - name: "Default-Gateway"
    type: "icmp"
    host: "192.168.1.1"
    count: 2
    description: "Основной шлюз (ping)"

  - name: "DNS-1"
    type: "icmp"
    host: "8.8.8.8"
    count: 2
    description: "Google DNS (ping)"

  - name: "DNS-2"
    type: "icmp"
    host: "1.1.1.1"
    count: 2
    description: "Cloudflare DNS (ping)"

  - name: "Web-Google"
    type: "http"
    url: "http://www.google.com"
    expected_status: 200
    timeout: 8
    description: "Веб-доступ (http)"

  - name: "Web-Google-HTTPS"
    type: "https"
    url: "https://www.google.com"
    expected_status: 200
    timeout: 8
    description: "Веб-доступ (https)"

  - name: "SMTP-Gateway"
    type: "tcp"
    host: "192.168.1.1"
    port: 25
    timeout: 5
    description: "SMTP-шлюз"

  - name: "DB-Server"
    type: "tcp"
    host: "192.168.1.10"
    port: 5432
    description: "PostgreSQL Database"

  # Системные метрики (psutil, работает на Windows и Linux):
  # - disk:   свободное место на диске
  # - cpu:    загрузка процессора (%)
  # - memory: использование оперативной памяти (%)
  # - network: суммарный сетевой трафик (Mbps за интервал)
  #
  # Для Linux путь к диску укажите явно, например "/" или "/home".
  # Для Windows используйте "C:\\", "D:\\" и т.д.
  # Если path не указан, агент сам подставит "/" на Linux и "C:\\" на Windows.

  - name: "LocalHost-Disk-C"
    type: "disk"
    path: "C:\\"
    threshold: 10
    description: "Диск C: свободное место (Windows)"

  # Пример для Linux:
  # - name: "LocalHost-Disk-Root"
  #   type: "disk"
  #   path: "/"
  #   threshold: 10
  #   description: "Корневой раздел свободное место (Linux)"

  - name: "LocalHost-CPU"
    type: "cpu"
    threshold: 90
    interval: 1
    description: "Загрузка процессора"

  - name: "LocalHost-Memory"
    type: "memory"
    threshold: 85
    description: "Использование оперативной памяти"

  - name: "LocalHost-Network"
    type: "network"
    interval: 1
    description: "Сетевой трафик (Mbps)"
