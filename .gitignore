# --- Виртуальные окружения ---
.venv/
.venv-win/
agent/.build-venv/

# --- Зависимости и сборка фронтенда ---
node_modules/
frontend/dist/
agent/build/
agent/dist/

# --- Кэши Python ---
__pycache__/
*.pyc
*.pyo

# --- Секреты и локальные конфиги ---
.env
backend/.env
agent/config.yaml
agent/config.local.yaml
*_token*.txt

# --- Базы данных ---
*.db
*.sqlite
*.sqlite3

# --- Логи и артефакты сборки ---
*.log
*.err
*.spec.bak

# --- Портал: уведомления и прочее ---
backend/outbox/
shots/
*.eml

# --- mTLS: CA-ключи и сертификаты (создаются автоматически при старте) ---
ca/
backend/ca/

# --- Клиент monic: бинарник, токен и локальный конфиг (секреты) ---
monic/*.exe
monic/TOKEN.txt
monic/config.yaml

# --- Одноразовые документы и скриншоты ---
*.docx
*.pdf
query
